{
  "name": "@monorepo-lit/web-components",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.es.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "@storybook/web-components": "^8.4.4",
    "@storybook/web-components-vite": "^8.4.4",
    "@types/node": "^22.9.1",
    "autoprefixer": "^10.4.20",
    "lit": "^3.2.1",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "postcss-nesting": "^13.0.1",
    "storybook-config": "^0.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "build:css": "node build-css.js",
    "build:tsc": "tsc",
    "build": "tsc && vite build",
    "build:styles": "node --loader ts-node/esm build-styles.ts",
    "lint": "eslint . ",
    "lint:fix": "eslint . --fix",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "prepublishOnly": "yarn build",
    "css:watch": "postcss src/**/*.css --watch --dir dist/components"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/index.css"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "browserslist": [
    "> 3%",
    "last 8 versions",
    "not dead"
  ],
  "ts-node": {
    "esm": true,
    "experimentalSpecifiers": true,
    "compilerOptions": {
      "module": "NodeNext",
      "moduleResolution": "NodeNext"
    }
  }
}
