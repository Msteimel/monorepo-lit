{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "target": "ESNext",
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "strict": true,
    "declarationMap": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.css",
    "src/custom.d.ts",
    ".storybook/**/*.ts",
    "index.ts",
    "src/**/*",
    "*.ts"
  ],
  "references": [],
  "ts-node": { "esm": true, "experimentalSpecifiers": true }
}
